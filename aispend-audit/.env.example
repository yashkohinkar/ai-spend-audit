# Environment variables — all OPTIONAL.
# The app runs and demos fully without any of these (SQLite + in-memory fallbacks
# + templated AI summary). Configure for production-grade features.

# AI-personalized summary. Unset → deterministic templated fallback is used.
# Apply for free credits: https://www.anthropic.com/pricing
ANTHROPIC_API_KEY=

# Production storage (Postgres). Unset → local SQLite (data.db) → in-memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (the anon key also works for reads; service-role recommended for inserts)

# Transactional confirmation email. Unset → email send is skipped, lead still stored.
RESEND_API_KEY=
MAIL_FROM="SpendScope <audit@yourdomain.com>"

# Canonical origin for Open Graph / share URLs (no trailing slash).
APP_URL=http://localhost:5000
